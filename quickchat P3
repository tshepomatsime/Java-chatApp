// ===================== MESSAGE CLASS =====================
// =========================================================
class Message {
    public String messageId;
    public int messageNumber;
    public String recipient;
    public String messageText;
    public String messageHash;
   
    // Assignment Requirements: Multiple Arrays
    public static ArrayList<Message> sentMessages = new ArrayList<>();
    public static ArrayList<Message> disregardedMessages = new ArrayList<>();
    public static ArrayList<Message> storedMessages = new ArrayList<>();
    public static ArrayList<String> messageHashes = new ArrayList<>();
    public static ArrayList<String> messageIDs = new ArrayList<>();

    public Message() {
        Random rand = new Random();
        long id = (long) (rand.nextDouble() * 9_000_000_000L) + 1_000_000_000L;
        this.messageId = String.valueOf(id);
    }

    // Populates all arrays and avoids hard-coding
    public static void addMessage(Message msg) {
        messageIDs.add(msg.messageId);
        messageHashes.add(msg.messageHash);

        // In a real UI, you'd base this on the choice, but for simplicity:
        if (msg.messageText != null && !msg.messageText.isEmpty()) {
            storedMessages.add(msg);
        }
    }

    public static void clearTestData() {
        sentMessages.clear();
        disregardedMessages.clear();
        storedMessages.clear();
        messageHashes.clear();
        messageIDs.clear();
    }

    public static int returnTotalMessages() {
        return sentMessages.size() + disregardedMessages.size() + storedMessages.size();
    }

    public boolean checkMessageID() {
        return messageId != null && messageId.length() <= 10;
    }

    public String checkMessageLength() {
        if (messageText.length() > 250) {
            int excess = messageText.length() - 250;
            return "Message exceeds 250 characters by " + excess + "; please reduce the size.";
        }
        return "Message ready to send.";
    }

    public String checkRecipientCell() {
        if (recipient != null && Pattern.matches("^\\+27[0-9]{7,9}$", recipient)) {
            return "Cell phone number successfully captured.";
        }
        return "Cell phone number is incorrectly formatted or does not contain an international code. Please correct the number and try again.";
    }

    public String createMessageHash() {
        return createMessageHashForTest(this.messageId, this.messageNumber, this.messageText);
    }

    public String createMessageHashForTest(String id, int msgNum, String text) {
        if (text == null || text.trim().isEmpty()) return "";
       
        String firstTwoId = id.length() >= 2 ? id.substring(0, 2) : id;
       
        String[] words = text.trim().split("\\s+");
        String firstWord = words[0].replaceAll("[^a-zA-Z]", "");
        String lastWord = words[words.length - 1].replaceAll("[^a-zA-Z]", "");
       
        if (words.length == 1) {
            return (firstTwoId + ":" + msgNum + ":" + firstWord).toUpperCase();
        }
       
        return (firstTwoId + ":" + msgNum + ":" + firstWord + lastWord).toUpperCase();
    }

    public String SentMessage(Scanner scanner) {
        if (!checkMessageID()) return "Message ID invalid.";
       
        String cellCheck = checkRecipientCell();
        if (!cellCheck.equals("Cell phone number successfully captured.")) return cellCheck;
       
        String lengthCheck = checkMessageLength();
        if (!lengthCheck.equals("Message ready to send.")) return lengthCheck;

        this.messageHash = createMessageHash();
        messageHashes.add(this.messageHash);
        messageIDs.add(this.messageId);

        System.out.println("\nChoose action:");
        System.out.println("1 - Send Message");
        System.out.println("2 - Disregard Message");
        System.out.println("3 - Store Message to send later");
        System.out.print("Choice: ");
        String choice = scanner.nextLine();

        switch (choice) {
            case "1":
                sentMessages.add(this);
                return "Message successfully sent";
            case "2":
                disregardedMessages.add(this);
                return "Press 0 to delete the message.";
            case "3":
                storedMessages.add(this);
                storeMessageToJSON();
                return "Message successfully stored";
            default:
                return "Invalid action. Message discarded.";
        }
    }

    // --- Methods to fulfill Stored Messages Menu (a-f) ---
   
    public String getLongestMessage() {
        if (storedMessages.isEmpty()) return "No stored messages available.";
        Message longest = storedMessages.get(0);
        for (Message m : storedMessages) {
            if (m.messageText.length() > longest.messageText.length()) {
                longest = m;
            }
        }
        return longest.messageText;
    }

    public String searchByID(String id) {
        for (Message m : messageIDs.size() > 0 ? storedMessages : new ArrayList<Message>()) {
            if (m.messageId.equals(id)) {
                return "Recipient: " + m.recipient + "\nMessage: " + m.messageText;
            }
        }
        return "Message ID not found.";
    }

    public String searchByRecipient(String rec) {
        StringBuilder sb = new StringBuilder();
        for (Message m : storedMessages) {
            if (m.recipient.equals(rec)) {
                sb.append(m.messageText).append("\n");
            }
        }
        return sb.length() > 0 ? sb.toString().trim() : "No messages found for this recipient.";
    }

    public String deleteByHash(String hash) {
        for (int i = 0; i < storedMessages.size(); i++) {
            if (storedMessages.get(i).messageHash.equalsIgnoreCase(hash)) {
                String deletedMsg = storedMessages.get(i).messageText;
                storedMessages.remove(i);
                return "Message: \"" + deletedMsg + "\" successfully deleted.";
            }
        }
        return "Message hash not found.";
    }

    public String generateReport() {
        if (storedMessages.isEmpty()) return "No messages to report.";
        StringBuilder report = new StringBuilder();
        report.append("--- Message Report ---\n");
        for (Message m : storedMessages) {
            report.append("Hash: ").append(m.messageHash)
                  .append(" | Recipient: ").append(m.recipient)
                  .append(" | Message: ").append(m.messageText).append("\n");
        }
        return report.toString();
    }

    // --- JSON Persistence (Writing) ---
    public void storeMessageToJSON() {
        try {
            FileWriter file = new FileWriter("messages.json", true);
            String json = String.format(
                "{\n  \"id\": \"%s\",\n  \"hash\": \"%s\",\n  \"recipient\": \"%s\",\n  \"message\": \"%s\"\n},\n",
                messageId, messageHash, recipient, messageText
            );
            file.write(json);
            file.close();
        } catch (IOException e) {
            System.out.println("Error saving to JSON file: " + e.getMessage());
        }
    }

    // --- JSON Persistence (Reading - Manual parse since we don't have external libraries) ---
    public void loadStoredMessagesFromJSON() {
        File file = new File("messages.json");
        if (!file.exists()) return;

        try (Scanner fileScanner = new Scanner(file)) {
            StringBuilder jsonContent = new StringBuilder();
            while (fileScanner.hasNextLine()) {
                jsonContent.append(fileScanner.nextLine()).append("\n");
            }
           
            // Extremely basic manual JSON parsing
            String[] entries = jsonContent.toString().split("},\\s*\\{");
            for (String entry : entries) {
                String id = extractJsonField(entry, "id");
                String hash = extractJsonField(entry, "hash");
                String rec = extractJsonField(entry, "recipient");
                String msg = extractJsonField(entry, "message");

                if (id != null && msg != null) {
                    Message loaded = new Message();
                    loaded.messageId = id;
                    loaded.messageHash = hash;
                    loaded.recipient = rec;
                    loaded.messageText = msg;
                    loaded.messageNumber = returnTotalMessages() + 1;
                   
                    // Check for duplicates before adding
                    boolean exists = false;
                    for(Message m : storedMessages) {
                        if(m.messageId.equals(loaded.messageId)) exists = true;
                    }
                    if(!exists) {
                        storedMessages.add(loaded);
                        messageHashes.add(hash);
                        messageIDs.add(id);
                    }
                }
            }
        } catch (FileNotFoundException e) {
            System.out.println("No existing message file found. Starting fresh.");
        }
    }

    private String extractJsonField(String json, String field) {
        String searchKey = "\"" + field + "\": \"";
        int startIndex = json.indexOf(searchKey);
        if (startIndex == -1) return null;
        startIndex += searchKey.length();
        int endIndex = json.indexOf("\"", startIndex);
        if (endIndex == -1) return null;
        return json.substring(startIndex, endIndex);
    }
}
